rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // USERS
    // Public profile fields only (display_name, friend_ids, elo, …).
    // PII (email, phone_number, fcm_token) lives under private/data
    // and is readable/writable only by the owner.
    // ============================================================
    match /users/{userId} {
      // Public profiles are readable by any signed-in user (friends search).
      // Sensitive fields must not be written here — see private/ below.
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && !hasPiiFields(request.resource.data);

      allow update: if request.auth != null
        && request.auth.uid == userId
        // Reject writes that touch PII keys with non-null values (legacy docs
        // may still *contain* PII fields until scrubbed — those must not block
        // unrelated profile updates).
        && doesNotWritePii()
        && (
          onlyOwnNonFriendFields()
          || onlyFriendIdsChanged()
          || onlyRemovingLegacyPii()
        );

      allow delete: if false;

      // Owner-only private bag: email, phone_number, fcm_token
      match /private/{docId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    // ============================================================
    // FRIEND REQUESTS
    // ============================================================
    match /friend_requests/{requestId} {
      allow read: if request.auth != null
        && (resource.data.from_user_id == request.auth.uid
            || resource.data.to_user_id == request.auth.uid);

      allow create: if request.auth != null
        && request.resource.data.from_user_id == request.auth.uid
        && request.resource.data.status == 'pending';

      allow update: if request.auth != null
        && resource.data.to_user_id == request.auth.uid;

      allow delete: if false;
    }

    // ============================================================
    // GAMES
    // Preferred create path is the createGame callable (Admin).
    // Client create is still allowed for older clients while waiting.
    // ============================================================
    match /games/{gameId} {
      allow read: if request.auth != null;

      // Any authenticated user can create a game (they become the host)
      allow create: if request.auth != null
        && request.resource.data.host_id == request.auth.uid
        && request.resource.data.state == 'waiting';

      // Only the host can update the game while it's in 'waiting' state.
      // Game state transitions (waiting→in_progress, in_progress→finished)
      // and winning_team are handled exclusively by Cloud Functions
      // via the Admin SDK (bypasses these rules).
      allow update: if request.auth != null
        && resource.data.host_id == request.auth.uid
        && resource.data.state == 'waiting'
        && request.resource.data.state == 'waiting'
        && isOnlyAddingSelfToPlayerIds() == false;

      // Players can add themselves to player_ids when joining
      allow update: if request.auth != null
        && isOnlyAddingSelfToPlayerIds();

      // Only the host can delete the game (lobby disbandment)
      allow delete: if request.auth != null
        && resource.data.host_id == request.auth.uid;

      // ----------------------------------------------------------
      // PLAYERS (subcollection of games)
      // ----------------------------------------------------------
      match /players/{playerId} {
        // Restrict reads: only players in the game can read player docs.
        // Role/identity data is still present in the doc, but limited to
        // game participants. Full role hiding would require a separate
        // secrets subcollection (future improvement).
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/games/$(gameId)).data.player_ids;

        // Seat yourself only while the lobby is open AND you are already
        // listed on player_ids (host create or a prior joinGame / array append).
        // Note: Swift Codable skips nil fields, so we check for absence OR null.
        // Preferred create path is createGame / joinGame callables (Admin).
        allow create: if request.auth != null
          && request.resource.data.user_id == request.auth.uid
          && get(/databases/$(database)/documents/games/$(gameId)).data.state == 'waiting'
          && request.auth.uid in get(/databases/$(database)/documents/games/$(gameId)).data.player_ids
          && (!('role' in request.resource.data) || request.resource.data.role == null)
          && (!('identity_card_id' in request.resource.data) || request.resource.data.identity_card_id == null);

        // Players can ONLY update their own unveil status (true only).
        // Life, elimination, role assignment, and card assignment are
        // handled exclusively by Cloud Functions.
        // Note: unveilPlayer Cloud Function also handles this, but
        // we keep the rule for backwards compat during migration.
        allow update: if request.auth != null
          && resource.data.user_id == request.auth.uid
          && onlyUnveilChanged();

        // Players can update their own player_color
        allow update: if request.auth != null
          && resource.data.user_id == request.auth.uid
          && onlyPlayerColorChanged();

        // Players can update their own commander_name
        allow update: if request.auth != null
          && resource.data.user_id == request.auth.uid
          && onlyCommanderNameChanged();

        // Players can remove themselves, or the host can remove anyone (lobby only)
        allow delete: if request.auth != null
          && (resource.data.user_id == request.auth.uid
              || isGameHost(gameId));
      }
    }

    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================
    function isGameHost(gameId) {
      return get(/databases/$(database)/documents/games/$(gameId)).data.host_id == request.auth.uid;
    }

    // True only for a write that appends the CALLER to an open lobby's
    // player_ids, leaving every existing member in place.
    //
    // Joins normally go through the joinGame callable, which enforces all of
    // this in a transaction. This path is kept — rather than denied outright —
    // because older iOS/Android builds in the wild may still write directly,
    // and a legitimate join from one of those must keep working.
    function isOnlyAddingSelfToPlayerIds() {
      let before = resource.data.player_ids;
      let after = request.resource.data.player_ids;
      let cap = 'max_players' in resource.data ? resource.data.max_players : 8;
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['player_ids', 'last_activity_at'])
        // The lobby must still be open.
        && resource.data.state == 'waiting'
        // Append-only: everyone already seated stays seated.
        && after.hasAll(before)
        && after.size() == before.size() + 1
        // ...and the single addition is the caller, joining for the first time.
        && !(request.auth.uid in before)
        && request.auth.uid in after
        // Mirror the capacity joinGame enforces so a direct write can't bypass it.
        && after.size() <= cap;
    }

    // Owners may edit their own friend_ids freely. Cross-user friend_ids
    // writes are denied — accept/remove go through Cloud Functions.
    function onlyFriendIdsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['friend_ids']);
    }

    function onlyOwnNonFriendFields() {
      return !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['friend_ids']);
    }

    // Allow scrubbing legacy email/phone/fcm fields off the public doc.
    function onlyRemovingLegacyPii() {
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      return keys.hasOnly(['email', 'phone_number', 'fcm_token'])
        && (!('email' in request.resource.data) || request.resource.data.email == null)
        && (!('phone_number' in request.resource.data) || request.resource.data.phone_number == null)
        && (!('fcm_token' in request.resource.data) || request.resource.data.fcm_token == null);
    }

    function hasPiiFields(data) {
      return ('email' in data && data.email != null)
        || ('phone_number' in data && data.phone_number != null)
        || ('fcm_token' in data && data.fcm_token != null);
    }

    // True when this write does not set any public PII field to a non-null value.
    function doesNotWritePii() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return (!affected.hasAny(['email', 'phone_number', 'fcm_token']))
        || onlyRemovingLegacyPii();
    }

    // Returns true when only is_unveiled is changed (and only to true)
    function onlyUnveilChanged() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return affectedKeys.hasOnly(['is_unveiled'])
        && request.resource.data.is_unveiled == true;
    }

    function onlyPlayerColorChanged() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return affectedKeys.hasOnly(['player_color']);
    }

    function onlyCommanderNameChanged() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return affectedKeys.hasOnly(['commander_name']);
    }
  }
}
